#include<iostream>
#include<string>
using namespace std;

class Node{
public:
    int postId;
    string userName;
    string content;
    int time;
    Node *next;
    Node *prev;

    Node(int id,string u,string c,int t){
        postId=id;
        userName=u;
        content=c;
        time=t;
        next=NULL;
        prev=NULL;
    }
};

class Post{
private:
    Node *head;
    int id;

public:
    Post(){
        head=NULL;
        id=1;
    }

    void getData(string &userName,string &content,int &time){
        cin.ignore();

        cout<<"Enter Username: ";
        getline(cin,userName);

        cout<<"Enter Content: ";
        getline(cin,content);
        cout<<"Enter time: ";
        cin>>time;

    }

    void insert(string userName,string content,int time){

        Node *nn=new Node(id++,userName,content, time);

        if(head==NULL){
            head=nn;
            return;
        }

        Node *temp=head;

        while(temp->next!=NULL){
            temp=temp->next;
        }

        temp->next=nn;
        nn->prev=temp;
    }

    // Insert at Position
    void insert_position(int pos,string userName,string content,int time){

        Node *nn=new Node(id++,userName,content,time);

        if(pos==1){
            nn->next=head;

            if(head!=NULL)
                head->prev=nn;

            head=nn;
            return;
        }

        Node *temp=head;
        int count=1;

        while(count<pos-1 && temp!=NULL){
            temp=temp->next;
            count++;
        }

        if(temp==NULL){
            cout<<"Invalid Position\n";
            delete nn;
            return;
        }

        nn->next=temp->next;
        nn->prev=temp;

        if(temp->next!=NULL)
            temp->next->prev=nn;

        temp->next=nn;
    }

    // Delete by Post ID
    void delete_post(int pid){

        if(head==NULL){
            cout<<"No Posts Available\n";
            return;
        }

        Node *temp=head;

        while(temp!=NULL && temp->postId!=pid){
            temp=temp->next;
        }

        if(temp==NULL){
            cout<<"Post Not Found\n";
            return;
        }

        if(temp==head){

            head=head->next;

            if(head!=NULL)
                head->prev=NULL;
        }

        else if(temp->next==NULL){

            temp->prev->next=NULL;
        }

        else{

            temp->prev->next=temp->next;
            temp->next->prev=temp->prev;
        }

        delete temp;
        cout<<"Post Deleted Successfully\n";
    }

    // Search by Post ID
    void search(int pid){

        Node *temp=head;

        while(temp!=NULL){

            if(temp->postId==pid){

                cout<<"\nPost Found\n";
                cout<<"Post ID : "<<temp->postId<<endl;
                cout<<"Username : "<<temp->userName<<endl;
                cout<<"Content : "<<temp->content<<endl;
                cout<<"Time : "<<temp->time<<endl;
                return;
            }

            temp=temp->next;
        }

        cout<<"Post Not Found\n";
    }


    void display(){

        if(head==NULL){
            cout<<"No Posts Available\n";
            return;
        }

        Node *temp=head;

        cout<<"\n=========== INSTAGRAM FEED ===========\n";

        while(temp!=NULL){

            cout<<"-----------------------------------\n";
            cout<<"Post ID   : "<<temp->postId<<endl;
            cout<<"Username  : "<<temp->userName<<endl;
            cout<<"Content   : "<<temp->content<<endl;
            cout<<"Time : "<<temp->time<<endl;

            temp=temp->next;
        }
    }


    void reverse(){

        if(head==NULL){
            cout<<"No Posts Available\n";
            return;
        }

        Node *temp=head;

        while(temp->next!=NULL){
            temp=temp->next;
        }

        cout<<"\n======= REVERSE INSTAGRAM FEED =======\n";

        while(temp!=NULL){

            cout<<"-----------------------------------\n";
            cout<<"Post ID   : "<<temp->postId<<endl;
            cout<<"Username  : "<<temp->userName<<endl;
            cout<<"Content   : "<<temp->content<<endl;
            cout<<"Time      : "<<temp->time<<endl;

            temp=temp->prev;
        }
    }
    void sort()
{
    Node *pointer = head;

    while(pointer != NULL)
    {
        Node *temp = pointer->next;

        while(temp != NULL)
        {
            if(pointer->time > temp->time)
            {
                // Swap Post ID
                int tId = pointer->postId;
                pointer->postId = temp->postId;
                temp->postId = tId;

                // Swap Username
                string tUser = pointer->userName;
                pointer->userName = temp->userName;
                temp->userName = tUser;

                // Swap Content
                string tContent = pointer->content;
                pointer->content = temp->content;
                temp->content = tContent;

                // Swap Time
                int tTime = pointer->time;
                pointer->time = temp->time;
                temp->time = tTime;
            }

            temp = temp->next;
        }

        pointer = pointer->next;
    }

    cout << "Posts Sorted Successfully by Time!!" << endl;
}
};

int main(){

    Post p;

    int choice,pos,id,time;
    string user,content;

    do{

        cout<<"\n1. Add Post";
        cout<<"\n2. Insert Post at Position";
        cout<<"\n3. Delete Post";
        cout<<"\n4. Search Post";
        cout<<"\n5. Display Feed";
        cout<<"\n6. Reverse Feed";
        cout<<"\n7. Sort";
        cout<<"\n8. Exit";

        cout<<"\nEnter Choice : ";
        cin>>choice;

        switch(choice){

        case 1:
            p.getData(user,content,time);
            p.insert(user,content,time);
            break;

        case 2:
            cout<<"Enter Position : ";
            cin>>pos;
            p.getData(user,content,time);
            p.insert_position(pos,user,content,time);
            break;

        case 3:
            cout<<"Enter Post ID : ";
            cin>>id;
            p.delete_post(id);
            break;

        case 4:
            cout<<"Enter Post ID : ";
            cin>>id;
            p.search(id);
            break;

        case 5:
            p.display();
            break;

        case 6:
            p.reverse();
            break;
       case 7:
            p.sort();
            break;

        case 8:
            cout<<"Thank You!"<<endl;
            break;

        default:
            cout<<"Invalid Choice";
        }

    }while(choice!=8);

    return 0;
}
