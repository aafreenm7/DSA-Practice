#include<iostream>
using namespace std;
class Node{
public:
    int coef;
    int power;
    Node *next;
    Node *prev;
    Node(int v1,int v2 ){
        coef=v1;
        power=v2;
        next=NULL;
        prev=NULL;
    }
};
class DoubleLinkList{
private:
    Node *head;
public:
int ans=0;
    DoubleLinkList(){
        head=NULL;
    }
    void insert(int v1,int v2){
        Node *nn=new Node(v1,v2);
        if(head==NULL){
            head=nn;

        }
        else{
            Node *temp=head;
            while(temp->next!=NULL){
                temp=temp->next;
            }            
            temp->next=nn;
            nn->prev=temp;

        }
    }
    void display(){
        Node *temp=head;
        cout<<"------------------------------DOUBLY-LINKEDLIST------------------------------"<<endl;
        while(temp!=NULL){
        cout << temp->coef << "x^" << temp->power;
               if (temp->next != NULL)
                cout << " + ";

            temp=temp->next;
        }
        cout<<endl;       
    }
    void add(){
        Node *temp1=head;       
        while(temp1!=NULL){
            Node*temp2=temp1->next;
        while(temp2!=NULL){

            if(temp1->power==temp2->power){
            ans=temp1->coef+temp2->coef;           
            }
          temp2=temp2->next;
           }

        cout << ans << "x^" << temp1->power;

        if(temp1->next!=NULL){
            cout << " + ";
        }

        temp1=temp1->next;
    }
}
   
};
int main (){
int n,c1,v1;
    DoubleLinkList d;
    DoubleLinkList d1;
    cout<<"Enter how many terms you want to input: ";
    cin>>n;
    for(int i=0;i<n;i++){
        cout<<"Enter coefficient: "<<endl;
        cin>>c1;
        cout<<"Enter exponent: "<<endl;
        cin>>v1;
        d.insert(c1,v1);
    }
    d.display();   
    d.add();
 
    
    return 0;	
    
}
